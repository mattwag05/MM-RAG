# MM-RAG configuration. Copy to .env and edit. All vars are optional; defaults shown.

# Where MM-RAG stores its SQLite DB and derived artifacts
# Default: ~/.local/share/mmrag
# MMRAG_DATA_DIR=/Users/you/.local/share/mmrag

# Ollama endpoint
# MMRAG_OLLAMA_URL=http://localhost:11434

# Default Gemma 4 reasoning model + fallback
# MMRAG_MODEL_PRIMARY=gemma4:e4b
# MMRAG_MODEL_FALLBACK=gemma4:e2b

# Social Bookmarks Triage REST endpoint (only used if push_to_sbt=true on ingest)
# MMRAG_SBT_URL=http://localhost:3000

# FastAPI bind
# MMRAG_API_HOST=127.0.0.1
# MMRAG_API_PORT=8765

# Logging level: DEBUG | INFO | WARNING | ERROR
# MMRAG_LOG_LEVEL=INFO

# Concurrency cap for the worker (parallel pipeline jobs)
# MMRAG_WORKER_CONCURRENCY=2
