# MM-RAG configuration. Copy to .env and edit. All vars are optional; defaults shown.

# Where MM-RAG stores its SQLite DB and derived artifacts
# Default: ~/.local/share/mmrag
# MMRAG_DATA_DIR=/Users/you/.local/share/mmrag

# Ollama endpoint
# MMRAG_OLLAMA_URL=http://localhost:11434

# Default Gemma 4 reasoning model + fallback
# MMRAG_MODEL_PRIMARY=gemma4:e4b
# MMRAG_MODEL_FALLBACK=gemma4:e2b

# FastAPI bind
# MMRAG_API_HOST=127.0.0.1
# MMRAG_API_PORT=8765

# Streamable HTTP MCP bind. Loopback is allowed without a token for local dev.
# Non-loopback binds require MMRAG_MCP_TOKEN.
# MMRAG_MCP_HOST=127.0.0.1
# MMRAG_MCP_PORT=8766
# MMRAG_MCP_PATH=/mcp
# MMRAG_MCP_TOKEN=change-me
# MMRAG_MCP_PUBLIC_URL=http://127.0.0.1:8766

# Docker Pi / self-hosted compose publish host. Use your server's private IP.
# Default in docker-compose.pi.yml: 127.0.0.1
# MMRAG_PUBLISH_HOST=127.0.0.1

# Logging level: DEBUG | INFO | WARNING | ERROR
# MMRAG_LOG_LEVEL=INFO

# Run ingest stages in the request process. Keep true for local dev; the
# Pi Compose file sets false so mmrag-worker owns heavy ingest work.
# MMRAG_INGEST_INLINE=true

# Concurrency cap for the worker (parallel pipeline jobs)
# MMRAG_WORKER_CONCURRENCY=2

# Speech-to-text model, resolved by onnx-asr. Parakeet TDT v3 is ~640 MB at
# int8; point this at a smaller onnx-asr model (e.g. whisper-base) on
# constrained hardware. Set quantization to the empty string for fp32.
# MMRAG_TRANSCRIBE_MODEL=nemo-parakeet-tdt-0.6b-v3
# MMRAG_TRANSCRIBE_QUANTIZATION=int8

# Height ceiling for downloaded video. On-screen text is unreadable below
# ~720p, so this decides what OCR and captioning can ever see. Lower it for
# bandwidth- or CPU-constrained deployments (360 roughly quarters the download
# and the per-frame cost, at the price of any on-screen text).
# MMRAG_MAX_VIDEO_HEIGHT=1080

# Fetch manual platform caption tracks (yt-dlp) and use them instead of ASR
# when present. Auto-generated captions are never fetched.
# MMRAG_SUBTITLES_ENABLED=true

# Ingest-time Florence-2 captioning of scenes with no speech and no OCR
# text. Set false to skip the ~469 MB model download entirely.
# MMRAG_CAPTION_ENABLED=true

# Backend for the opt-in synthesize=true path. "ollama" (default) talks to
# MMRAG_OLLAMA_URL. "minicpm" loads MiniCPM-V-4.6 locally and can reason over
# retrieved frame JPEGs as well as the evidence text — but needs ~5.9 GB
# resident, so it is Mac/workstation only, never a Pi. Neither runs unless a
# caller passes synthesize=true.
# MMRAG_SYNTHESIZE_PROVIDER=ollama
# MMRAG_SYNTHESIZE_MODEL=openbmb/MiniCPM-V-4_6
# MMRAG_SYNTHESIZE_MAX_FRAMES=4

# Graph retrieval can be disabled for constrained Pi profiles
# MMRAG_GRAPH_ENABLED=true

# Query-time vector encoding. Pi MCP disables this so transport stays light.
# MMRAG_QUERY_VECTOR_ENABLED=true

# Vector backend selection. sqlite is the default; qdrant is optional.
# MMRAG_VECTOR_BACKEND=sqlite
# MMRAG_QDRANT_URL=http://127.0.0.1:6333
